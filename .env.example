ODDS_API_KEY=YOUR_KEY_HERE
# get free key at https://the-odds-api.com/ (500 req/mo free)
# regions: us,eu,uk,au | markets: h2h,spreads,totals
# NOTE: api.the-odds-api.com is BLOCKED on this network (Sophos gambling filter,
# cat=21), so live NBA game odds come from ESPN (sports.core.api.espn.com) via
# tools/t60_snapshot.py. Keep the key for other networks only.

# --- player-prop prices (tools/props_capture.py, 2026-27 props board) ---
# SharpAPI: reachable here; free tier = 12 req/min, 2 books, 60s delay, pre-match
# only, no documented monthly request cap. Key rides in the X-API-Key header.
SHARPAPI_KEY=YOUR_KEY_HERE
# SportsGameOdds: 9 books + settlement data; free tier includes player props
# (2,500 objects/month, 10 req/min). BLOCKED locally -> captured from the GitHub
# Actions runner as the repo secret of the same name.
SPORTSGAMEODDS_KEY=YOUR_KEY_HERE

